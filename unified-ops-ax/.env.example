# Copy to .env and fill as needed. All optional — defaults run offline.

# --- Database ---
# Dev default (SQLite). Prod: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite+pysqlite:///./unified_ops.db

# --- AI Gateway ---
# provider: fake | anthropic | openai | onprem
DEFAULT_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# On-prem (Ollama / vLLM OpenAI-compatible endpoint)
ONPREM_BASE_URL=http://localhost:11434
ONPREM_MODEL=llama3

# --- Embeddings ---
# provider: fake | openai | onprem
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=384

# --- Vector store ---
# backend: memory | pgvector
VECTOR_BACKEND=memory

# --- SaaS orchestration (P2) ---
# accounting: fake | douzone | quickbooks
ACCOUNTING_PROVIDER=fake
# QuickBooks Online (ACCOUNTING_PROVIDER=quickbooks)
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
QBO_BASE_URL=https://quickbooks.api.intuit.com
QBO_CUSTOMER_REF=1
# calendar: fake | msgraph | google
CALENDAR_PROVIDER=fake
# msgraph calendar mailbox (user id or UPN), e.g. ops@contoso.com
CALENDAR_USER_ID=
CURRENCY=KRW

# --- Microsoft Graph (SharePoint / Teams connector) ---
# App registration with application permissions (admin-consented):
#   Sites.Read.All, Files.Read.All, Group.Read.All
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# SharePoint site id: GET /sites/{hostname}:/sites/{path}
SHAREPOINT_SITE_ID=
# Teams: the backing M365 group id (files live in its default drive)
TEAMS_GROUP_ID=
